{
  "name": "lips-night",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint app components lib middleware.ts --ext .ts,.tsx",
    "test:microcms": "node scripts/test-microcms.mjs",
    "test": "node --test scripts/tests/*.cjs",
    "typecheck": "next typegen && tsc --noEmit",
    "check:production": "node scripts/check-production-config.mjs",
    "db:backup": "node scripts/backup-database.mjs",
    "db:generate": "prisma generate",
    "db:deploy": "prisma migrate deploy",
    "postinstall": "prisma generate",
    "check:release": "npm run check:production && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@prisma/client": "^6.16.1",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.468.0",
    "next": "15.5.28",
    "qrcode": "^1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "resend": "^6.1.1",
    "stripe": "^18.5.0",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/qrcode": "^1.5.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "^0.170.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "15.5.28",
    "postcss": "^8.4.49",
    "prisma": "^6.16.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=22.13.0 <23"
  }
}
